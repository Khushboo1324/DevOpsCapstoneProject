region             = "ap-south-1"
cluster_name       = "taskboard-capstone"
kubernetes_version = "1.35"
# Set to your GitHub owner/repo to create the OIDC deploy role:
# github_repository = "YOUR_OWNER/YOUR_REPO"
# Restrict to your workstation and self-hosted runner egress IPs when possible:
# public_access_cidrs = ["YOUR_PUBLIC_IP/32"]
# Existing account-wide GitHub OIDC provider, if present:
# github_oidc_provider_arn = "YOUR_PROVIDER_ARN"
